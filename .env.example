# O arquivo .env é OPCIONAL: toda variável abaixo já tem valor padrão no docker-compose.yml,
# e `docker compose up -d --build` sobe tudo sem ele. Copie para .env na raiz só para trocar algum valor.

# Mesmo segredo para usuarios (assina o JWT) e gateway (confere a assinatura).
# Não use os caracteres | & \ no valor.
JWT_SECRET=supersecret_ecommerce_jwt_key_2026

# Cache da vitrine do catálogo (Redis).
# REDIS_URL=redis://redis:6379
# CACHE_TTL_SEGUNDOS=60
